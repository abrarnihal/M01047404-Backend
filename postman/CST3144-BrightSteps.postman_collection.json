{
  "info": {
    "name": "CST3144 BrightSteps API",
    "description": "CST3144 coursework requests for the Express and MongoDB service. Run GET /lessons first; it saves the first record's id into lessonId. The enrolment request is included to demonstrate the back-end-only challenge and is not called by the frontend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Get all lessons (sets lessonId)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/lessons", "host": ["{{baseUrl}}"], "path": ["lessons"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const lessons = pm.response.json();",
              "if (Array.isArray(lessons) && lessons.length > 0 && lessons[0]._id) {",
              "  pm.collectionVariables.set('lessonId', lessons[0]._id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Search lessons by text, price, and availability",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/lessons/search?q=art&minPrice=8&maxPrice=15&available=true",
          "host": ["{{baseUrl}}"],
          "path": ["lessons", "search"],
          "query": [
            { "key": "q", "value": "art" },
            { "key": "minPrice", "value": "8" },
            { "key": "maxPrice", "value": "15" },
            { "key": "available", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "Get all teachers",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/teachers", "host": ["{{baseUrl}}"], "path": ["teachers"] }
      }
    },
    {
      "name": "Get a teacher's lessons",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/teachers/{{teacherId}}/lessons",
          "host": ["{{baseUrl}}"],
          "path": ["teachers", "{{teacherId}}", "lessons"]
        }
      }
    },
    {
      "name": "Create an order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Student\",\n  \"phone\": \"0123456789\",\n  \"lessonIDs\": [\"{{lessonId}}\"]\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] }
      }
    },
    {
      "name": "Update a lesson attribute (topic)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"Postman Demo Topic\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/lessons/{{lessonId}}", "host": ["{{baseUrl}}"], "path": ["lessons", "{{lessonId}}"] }
      }
    },
    {
      "name": "Set remaining spaces to an exact value",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"space\": 4\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/lessons/{{lessonId}}", "host": ["{{baseUrl}}"], "path": ["lessons", "{{lessonId}}"] }
      }
    },
    {
      "name": "Get enrolment count",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/enrolment/{{lessonId}}", "host": ["{{baseUrl}}"], "path": ["enrolment", "{{lessonId}}"] }
      }
    },
    {
      "name": "Get lesson image",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/lesson-images/clay.svg", "host": ["{{baseUrl}}"], "path": ["lesson-images", "clay.svg"] }
      }
    },
    {
      "name": "Missing lesson image returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/lesson-images/not-found.svg", "host": ["{{baseUrl}}"], "path": ["lesson-images", "not-found.svg"] }
      }
    },
    {
      "name": "Unknown route returns 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/not-a-route", "host": ["{{baseUrl}}"], "path": ["not-a-route"] }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://m01047404-cst3144-api.onrender.com" },
    { "key": "lessonId", "value": "" },
    { "key": "teacherId", "value": "olivia-bennett" }
  ]
}


